# scripts/init_env.py создаёт .env с уникальными паролем и webhook-секретом.
# Compose автоматически читает .env. Рабочие токены передавайте только приватно.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
MAX_BOT_TOKEN=
# Необязательно: дополнительный CA только для MAX. По умолчанию включён
# официальный публичный сертификат config/certs/russian_trusted_root_ca.crt.
# MAX_CA_CERT_FILE=/absolute/path/to/trusted-max-ca.crt
MAX_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BOT_DOMAIN=bot.example.com
MAX_WEBHOOK_URL=https://bot.example.com/webhook

# Бесплатная локальная модель; платные API не используются.
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_THREADS=4
AI_CONTEXT_TOKENS=16384
# cpu — процессор; auto — автоматический выбор доступного устройства.
AI_DEVICE=cpu
# Держать модель в памяти между вопросами, сокращая повторные загрузки.
AI_KEEP_ALIVE=30m
# 0 — без ограничения времени генерации; положительное значение — лимит одного вызова.
AI_TIMEOUT_SECONDS=0
# Внутреннее рассуждение модели для проверки ответа; в чат оно не выводится.
AI_THINK=false
SEARCH_MAX_PAGES=12
SOURCE_TTL_HOURS=24

# Только для Python на хосте с compose.local.yaml. Compose использует PG*.
DATABASE_URL=postgresql://max_bot:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:55432/max_bot
DEMO_DATABASE_URL=postgresql://max_bot:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:55432/max_bot_demo
TEST_DATABASE_URL=postgresql://max_bot:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:55432/max_bot_test
# Локальная админка; отдельный секрет, не токен MAX.
ADMIN_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN
# Необязательная HTTPS-ссылка на контакт вашего консультанта.
CONSULTANT_URL=
